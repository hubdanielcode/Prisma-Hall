art {\n  id        String   @id @default(uuid())\n  userId    String   @map(\"user_id\")\n  productId String?  @map(\"product_id\")\n  eventId   String?  @map(\"event_id\")\n  type      ItemType @map(\"item_type\")\n  quantity  Int\n  price     Decimal\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  event   Event?   @relation(fields: [eventId], references: [id])\n  product Product? @relation(fields: [productId], references: [id])\n  user    User     @relation(fields: [userId], references: [id])\n\n  @@unique([userId, productId])\n  @@unique([userId, eventId])\n  @@map(\"cart\")\n}\n\nmodel Product {\n  id          String          @id @default(uuid())\n  name        String          @unique\n  category    ProductCategory\n  description String          @unique\n  image       String\n  price       Decimal\n  quantity    Int\n  status      ProductStatus\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  carts    Cart[]\n  vouchers Voucher[]\n\n  @@map(\"products\")\n}\n\nmodel Voucher {\n  id        String        @id @default(uuid())\n  orderId   String        @default(uuid()) @map(\"order_id\")\n  userId    String        @map(\"user_id\")\n  productId String        @map(\"product_id\")\n  quantity  Int\n  unitPrice Decimal       @map(\"unit_price\")\n  status    VoucherStatus @default(active)\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  order   VoucherOrder @relation(fields: [orderId], references: [id])\n  product Product      @relation(fields: [productId], references: [id])\n  user    User         @relation(fields: [userId], references: [id])\n\n  @@index([userId])\n  @@index([orderId])\n  @@index([productId])\n  @@map(\"voucher\")\n}\n\nmodel VoucherOrder {\n  id     String      @id @default(uuid())\n  userId String      @map(\"user_id\")\n  status OrderStatus @map(\"order_status\")\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  vouchers        Voucher[]\n  user            User             @relation(fields: [userId], references: [id])\n  voucherPayments VoucherPayment[]\n\n  @@index([userId])\n  @@map(\"voucher_orders\")\n}\n\nmodel VoucherPayment {\n  id          String        @id @default(uuid())\n  userId      String        @map(\"user_id\")\n  orderId     String        @map(\"order_id\")\n  method      PaymentMethod @map(\"payment_method\")\n  status      PaymentStatus @map(\"payment_status\")\n  totalValue  Decimal       @map(\"total_value\")\n  confirmedAt DateTime?     @map(\"confirmed_at\")\n  pickedUpAt  DateTime?     @map(\"picked_up_at\")\n\n  // 1. Cobrança do Stripe que pagou este pagamento; é o que o reembolso usa para não precisar procurar a cobrança\n  paymentIntentId String? @map(\"payment_intent_id\")\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  order VoucherOrder @relation(fields: [orderId], references: [id])\n  user  User         @relation(fields: [userId], references: [id])\n\n  @@index([orderId, createdAt])\n  @@index([userId])\n  @@map(\"voucher_payments\")\n}\n\nmodel Ticket {\n  id        String       @id @default(uuid())\n  orderId   String       @default(uuid()) @map(\"order_id\")\n  userId    String       @map(\"user_id\")\n  eventId   String       @map(\"event_id\")\n  quantity  Int\n  unitPrice Decimal      @map(\"unit_price\")\n  status    TicketStatus @default(active)\n\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  event Event       @relation(fields: [eventId], references: [id])\n  order TicketOrder @relation(fields: [orderId], references: [id])\n  user  User        @relation(fields: [userId], references: [id])\n\n  @@index([userId])\n  @@index([orderId])\n  @@index([ev