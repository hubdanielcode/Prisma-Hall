generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime  @map("expires_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")

  user User @relation(fields: [userId], references: [id])

  @@map("session")
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String
  role           UserRole       @default(user)
  verifiedBadge  Boolean        @default(false) @map("verified_user")
  frequentUser   UserBadgeLevel @default(none) @map("frequent_user")
  oldUser        UserBadgeLevel @default(none) @map("old_user")
  token          String?        @unique
  tokenExpiresAt DateTime?      @map("token_expires_at")
  profilePicture String?

  createdAt   DateTime  @default(now()) @map("created_at")
  validatedAt DateTime? @map("validated_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  carts           Cart[]
  galleries       Gallery[]
  galleryLikes    GalleryLikes[]
  profiles        Profile?
  reviews         Review[]
  sessions        Session[]
  ticketOrders    TicketOrder[]
  ticketPayments  TicketPayment[]
  tickets         Ticket[]
  vouchers        Voucher[]
  voucherOrders   VoucherOrder[]
  voucherPayments VoucherPayment[]

  @@map("users")
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  phoneNumber          String   @map("phone_number")
  birthDate            DateTime @map("birth_date")
  city                 String
  neighborhood         String
  street               String
  number               String
  complement           String
  socialSecurityNumber String
  state                String
  zipCode              String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String?  @map("product_id")
  eventId   String?  @map("event_id")
  type      ItemType @map("item_type")
  quantity  Int
  price     Decimal

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event   Event?   @relation(fields: [eventId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@map("cart")
}

model Product {
  id          String          @id @default(uuid())
  name        String          @unique
  category    ProductCategory
  description String          @unique
  image       String
  price       Decimal
  quantity    Int
  status      ProductStatus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  carts    Cart[]
  vouchers Voucher[]

  @@map("products")
}

model VoucherPayment {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  orderId    String?       @map("order_id")
  method     PaymentMethod @map("payment_method")
  status     PaymentStatus @map("payment_status")
  totalValue Decimal       @map("total_value")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  pickedUpAt DateTime? @map("picked_up_at")

  voucherOrder VoucherOrder? @relation(fields: [orderId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@map("voucher_payments")
}

model VoucherOrder {
  id     String      @id @default(uuid())
  userId String      @map("user_id")
  status OrderStatus @map("order_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vouchers       Voucher[]
  user           User             @relation(fields: [userId], references: [id])
  voucherPayment VoucherPayment[]

  @@map("voucher_orders")
}

model Voucher {
  id        String @id @default(uuid())
  orderId   String @default(uuid()) @map("order_id")
  userId    String @map("user_id")
  productId String @map("product_id")
  quantity  Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order   VoucherOrder @relation(fields: [orderId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@map("voucher")
}

model Event {
  id             String      @id @default(uuid())
  title          String
  description    String
  tag            EventTag
  attractionName String      @map("attraction_name")
  image          String
  status         EventStatus
  price          Decimal
  startsAt       DateTime    @map("starts_at")
  attendees      Int         @default(0)
  rating         Decimal     @default(0.0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  carts      Cart[]
  attraction Attraction @relation(fields: [attractionName], references: [name])
  galleries  Gallery[]
  reviews    Review[]
  tickets    Ticket[]

  @@map("events")
}

model Attraction {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  image       String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("attractions")
}

model Review {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  eventId String  @map("event_id")
  rating  Decimal
  comment String? @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Gallery {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  eventId    String   @map("event_id")
  image      String
  title      String
  happenedAt DateTime @map("happened_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("gallery")
}

model GalleryLikes {
  userId  String @map("user_id")
  imageId String @map("image_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, imageId])
  @@map("gallery_likes")
}

model Ticket {
  id        String  @id @default(uuid())
  orderId   String  @default(uuid()) @map("order_id")
  userId    String  @map("user_id")
  eventId   String  @map("event_id")
  quantity  Int
  unitPrice Decimal @map("unit_price")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event       @relation(fields: [eventId], references: [id])
  order TicketOrder @relation(fields: [orderId], references: [id])
  user  User        @relation(fields: [userId], references: [id])

  @@map("tickets")
}

model TicketOrder {
  id     String      @id @default(uuid())
  userId String      @map("user_id")
  status OrderStatus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  ticketPayments TicketPayment[]
  tickets        Ticket[]

  @@map("ticket_orders")
}

model TicketPayment {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  orderId     String        @map("order_id")
  method      PaymentMethod @map("payment_method")
  status      PaymentStatus
  totalValue  Decimal       @map("total_value")
  confirmedAt DateTime?     @map("confirmed_at")
  pickedUpAt  DateTime?     @map("picked_up_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order TicketOrder @relation(fields: [orderId], references: [id])
  user  User        @relation(fields: [userId], references: [id])

  @@map("ticket_payments")
}

// 1. Geral

enum ItemType {
  drinks
  tickets
}

enum OrderStatus {
  confirmed
  pending
  cancelled
}

enum PaymentMethod {
  cash
  pix
  creditCard
  debitCard
}

enum PaymentStatus {
  confirmed
  pending
  failed
  refunded
}

// 2. Usuários

enum UserRole {
  user
  admin
}

enum UserBadgeLevel {
  none
  bronze
  silver
  gold
}

// 3. Produtos

enum ProductCategory {
  beers
  cocktails
  drinks
  no_alcohol
}

enum ProductStatus {
  active
  inactive
}

// 4. Eventos

enum EventTag {
  trap_and_hiphop
  forro
  samba_and_pagode
  metal
  eletronica
  funk
  rock
  pop
}

enum EventStatus {
  happened
  soon
}
